# Asset meta data MUST be checked in (do NOT ignore *.meta)
# Exception: Asset Store tools (optional)
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / IDE caches
.vs/
.vscode/
.idea/
*.swp
*.swo

# Gradle cache
.gradle/

# Autogenerated VS / MonoDevelop / Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files (do NOT ignore *.meta in general)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.ipa
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android StreamingAssets
/[Aa]ssets/[Ss]treamingAssets/aa/
/[Aa]ssets/[Ss]treamingAssets/aa.meta

# Large third-party asset textures (kept locally only; replace manually after clone).
# These dominate repo size (156 .tga, each 48-64 MB) and exceed GitHub's 2 GB cap.
Assets/Arts/ExternalArts/**/*.tga
*.unitypackage

# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# AI / editor scratch (personal, not part of project source)
.codex/
.cursor/
.cursorindexingignore
.opencode/
AGENTS.md
node_modules/

# Local per-user IDE configs that should not be shared
*.csproj.user